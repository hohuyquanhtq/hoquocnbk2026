rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hohuyquanhtq@gmail.com'
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isTeacher() {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        )
      );
    }

    function isServerWrite() {
      return request.resource.data.secretKey == 'eduquiz_srv_8e27d949';
    }

    function isServerRead() {
      return resource.data.secretKey == 'eduquiz_srv_8e27d949';
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Internal Teacher authentication credentials collection (server-gated)
    match /teachers/{teacherId} {
      allow get: if isServerRead();
      allow list: if isServerRead();
      allow create, update: if isServerWrite();
      allow delete: if isServerRead();
    }

    // Users collection (Google OAuth / profile records)
    match /users/{userId} {
      allow get: if isServerRead() || (isSignedIn() && (request.auth.uid == userId || isAdmin()));
      allow list: if isServerRead() || isAdmin();
      allow create: if isServerWrite() || (isSignedIn() && request.auth.uid == userId);
      allow update: if isServerWrite() || (isSignedIn() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        isAdmin()
      ));
      allow delete: if isServerRead() || isAdmin();
    }

    // Quizzes metadata collection (teachers only)
    match /quizzes/{quizId} {
      allow get: if isServerRead() || (isSignedIn() && resource.data.teacherId == request.auth.uid) || isAdmin();
      allow list: if isServerRead() || (isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdmin()));
      allow create: if isServerWrite() || (isSignedIn() && (isTeacher() || isSuperAdmin()) && request.resource.data.teacherId == request.auth.uid);
      allow update: if isServerWrite() || (isSignedIn() && ((resource.data.teacherId == request.auth.uid) || isAdmin()));
      allow delete: if isServerRead() || (isSignedIn() && ((resource.data.teacherId == request.auth.uid) || isAdmin()));
    }

    // Quiz details (contains answer keys & solutions - protected from students)
    match /quizDetails/{quizId} {
      allow get: if isServerRead() || (isSignedIn() && resource.data.teacherId == request.auth.uid) || isAdmin();
      allow create, update: if isServerWrite() || (isSignedIn() && ((request.resource.data.teacherId == request.auth.uid) || isAdmin()));
      allow delete: if isServerRead() || (isSignedIn() && ((resource.data.teacherId == request.auth.uid) || isAdmin()));
    }

    // Public Quiz (sanitized questions without answers)
    match /quizPublic/{quizId} {
      // Anyone can read public quiz definition to take the test
      allow get: if true;
      allow list: if true;
      // Only server, teacher or admin can publish
      allow create, update, delete: if isServerWrite() || (isSignedIn() && (isTeacher() || isAdmin()));
    }

    // Attempts (student test submissions)
    match /attempts/{attemptId} {
      // Allow student to read their own result by attempt ID
      allow get: if true;
      // Teacher or server can list all attempts for their quizzes
      allow list: if isServerRead() || (isSignedIn() && resource.data.teacherId == request.auth.uid) || isAdmin();
      // Any student or server can submit an attempt
      allow create: if isServerWrite() || request.resource.data.id == attemptId;
      // Teacher, server or admin can delete attempts
      allow update, delete: if isServerRead() || (isSignedIn() && ((resource.data.teacherId == request.auth.uid) || isAdmin()));
    }
  }
}
